# Server
PORT=8080
PUBLIC_BASE_URL=https://your-public-tunnel.example
DB_PATH=signoff.db

# Kite (testnet default)
KITE_NETWORK=testnet
FACILITATOR_URL=https://facilitator.pieverse.io/v2
# Processor wallet: receives the buyer's payment, pays the seller, issues refunds.
PAY_TO=0x0000000000000000000000000000000000000000
PROCESSOR_PRIVATE_KEY=
# Seller payout address (a raw Kite testnet EVM wallet in the demo).
SELLER_PAYOUT_ADDRESS=0x0000000000000000000000000000000000000000
JOB_PRICE_USD=0.05
FEE_BPS=200

# SERV Reasoning (required)
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini

# Dolphin (optional seller model; mock fallback if absent)
DOLPHIN_API_KEY=
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Reppo (optional appeals court)
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
REPPO_SETTLEMENT_MINUTES=10

# Dev switches. Leave false for the live demo; the receipt labels the mode.
DEV_SKIP_PAYMENT=false
DEV_MOCK_VERDICT=false
DEV_MOCK_PAYOUT=false
